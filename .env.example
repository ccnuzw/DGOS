NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://dgos:dgos@127.0.0.1:5432/dgos
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=dgos-local
S3_REGION=us-east-1
SECRET_BACKEND=development-memory

# KMS Configuration (Production Required)
# KMS_PROVIDER options: dev (development only), vault, aws
KMS_PROVIDER=dev

# Vault KMS Configuration
# VAULT_ADDR=http://localhost:8200
# VAULT_AUTH_METHOD=token
# VAULT_TOKEN=dev-root-token
# VAULT_NAMESPACE=
# VAULT_MOUNT_PATH=secret/dgos

# Vault AppRole Authentication (Production)
# VAULT_AUTH_METHOD=approle
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# Vault Kubernetes Authentication (K8s Deployment)
# VAULT_AUTH_METHOD=kubernetes
# VAULT_ROLE_NAME=dgos-api

# AWS KMS Configuration (Future)
# AWS_REGION=us-west-2
# AWS_KMS_KEY_ID=alias/dgos-master-key
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
