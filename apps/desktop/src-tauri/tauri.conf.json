{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DGOS",
  "version": "0.1.0",
  "identifier": "com.dgos.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:15151",
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "PORT=15151 pnpm --filter @dgos/web dev",
    "beforeBuildCommand": "pnpm --filter @dgos/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "icon": ["icons/icon.icns", "icons/icon.png"]
  }
}
