{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dgos:app-manifest:v1",
  "title": "DGOS application manifest v1",
  "type": "object",
  "required": ["format", "appId", "version", "build", "releaseChannel", "minRuntimeVersion", "dataVersion", "name", "description", "category", "icon", "defaultWindow", "entrypoints", "permissions", "capabilityAllowlist", "trustLevel", "backgroundPolicy", "uninstallPolicy"],
  "properties": {
    "format": { "const": "dgos-app/v1" },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" },
    "build": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "dataVersion": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "releaseChannel": { "enum": ["stable", "beta", "dev"] },
    "minRuntimeVersion": { "type": "string", "minLength": 1 },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "category": { "type": "string", "minLength": 1 },
    "icon": { "$ref": "#/$defs/relativePath" },
    "entrypoints": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
    "trustLevel": { "enum": ["standard", "trusted", "system"], "description": "Requested trust only. Installer computes effective trust from verified issuer and explicit platform grants. A declaration never grants trust." },
    "uninstallPolicy": { "enum": ["user-removable", "protected-preinstall"], "description": "Release-policy declaration; effective value must be authorized by the issuer/platform administrator. Developer declarations alone cannot protect an installation." },
    "backgroundPolicy": { "enum": ["release", "keep-alive"] },
    "permissions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "capabilityAllowlist": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "networkAllowlist": { "type": "array", "items": { "type": "string" } },
    "defaultWindow": { "type": "object", "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "minWidth": { "type": "integer", "minimum": 1 }, "minHeight": { "type": "integer", "minimum": 1 }, "resizable": { "type": "boolean" }, "maximizable": { "type": "boolean" } }, "additionalProperties": false },
    "dependencies": { "type": "object", "properties": { "apps": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/appDependency" } }, "skills": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/skillDependency" } }, "mcp": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/mcpDependency" } } }, "additionalProperties": false },
    "actions": { "type": "array", "items": { "$ref": "#/$defs/actionDeclaration" } },
    "agent": { "type": ["object", "null"] },
    "dataMigration": { "type": "object", "required": ["from", "entry"], "properties": { "from": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }, "entry": { "$ref": "#/$defs/relativePath", "pattern": "\\.json$", "description": "Signed package resource conforming to V1-app-data-migration.schema.json; never JavaScript, shell or arbitrary executable code." } }, "additionalProperties": false },
    "displayName": { "$ref": "#/$defs/localizedText" },
    "accentColor": { "type": "string", "description": "Registered semantic token, never arbitrary CSS" },
    "preferredWindow": { "type": "object" },
    "minWindowSize": { "type": "object" },
    "routes": { "type": "array", "items": { "type": "string" } },
    "deepLinks": { "type": "array", "items": { "type": "string" } },
    "supportedLocales": { "type": "array", "items": { "type": "string" } },
    "commands": { "type": "array", "items": { "type": "object" }, "description": "Registered UI commands, not shell commands" },
    "settingsSections": { "type": "array", "items": { "type": "object" } },
    "uiCapabilities": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$", "description": "Exact SemVer, validated by the platform SemVer parser; no ranges, wildcard, latest or coercion." },
    "stableId": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "operationIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
    "appDependency": { "type": "object", "additionalProperties": false, "required": ["appId", "version"], "properties": { "appId": { "$ref": "#/$defs/stableId" }, "version": { "$ref": "#/$defs/semver" } } },
    "skillDependency": { "type": "object", "additionalProperties": false, "required": ["packageId", "skillId", "version", "operationIds"], "properties": { "packageId": { "$ref": "#/$defs/stableId" }, "skillId": { "$ref": "#/$defs/stableId" }, "version": { "$ref": "#/$defs/semver" }, "operationIds": { "$ref": "#/$defs/operationIds" } } },
    "mcpDependency": { "type": "object", "additionalProperties": false, "required": ["sourceId", "version", "operationIds"], "properties": { "sourceId": { "$ref": "#/$defs/stableId" }, "version": { "$ref": "#/$defs/semver" }, "operationIds": { "$ref": "#/$defs/operationIds" } } },
    "actionDeclaration": {
      "type": "object", "additionalProperties": false,
      "required": ["actionId", "version", "label", "inputSchema", "outputSchema", "requiredCapabilities", "risk", "sideEffects", "confirmation", "idempotency", "cancellable", "handler"],
      "properties": {
        "actionId": { "$ref": "#/$defs/stableId", "description": "Unique within the package and prefixed with appId plus a dot; platform rejects collision with other applications/system actions." },
        "version": { "$ref": "#/$defs/semver" },
        "label": { "$ref": "#/$defs/localizedText" },
        "inputSchema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } }, "description": "Validated data schema only; no executable expressions, remote refs or code. Runtime must enforce all declared constraints." },
        "outputSchema": { "type": "object", "required": ["type"], "properties": { "type": { "const": "object" } } },
        "requiredCapabilities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" }, "description": "Every capability must be declared in both permissions and capabilityAllowlist and authorized at execution." },
        "risk": { "enum": ["read", "write", "external", "destructive"] },
        "sideEffects": { "enum": ["none", "local-write", "external-call", "model-call", "secret-use", "destructive"] },
        "confirmation": { "enum": ["none", "required", "elevated"] },
        "idempotency": { "enum": ["safe", "required", "unsupported"] },
        "cancellable": { "type": "boolean" },
        "handler": { "$ref": "#/$defs/stableId", "description": "Operator/platform-registered capability handler ID only, never module path, JS, shell or URL; handler effective privileges cannot exceed package grant." }
      },
      "allOf": [{ "if": { "properties": { "sideEffects": { "not": { "const": "none" } } }, "required": ["sideEffects"] }, "then": { "properties": { "confirmation": { "enum": ["required", "elevated"] } } } }]
    },
    "localizedText": { "type": "object", "required": ["zh-CN", "en-US"], "additionalProperties": { "type": "string", "minLength": 1 } },
    "relativePath": { "type": "string", "minLength": 1, "description": "Package-relative POSIX path. Runtime must additionally reject traversal, absolute/drive/UNC paths, NUL, backslash, symlinks and resolved paths outside the package root." }
  }
}
