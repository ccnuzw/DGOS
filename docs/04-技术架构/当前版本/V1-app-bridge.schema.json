{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dgos:app-bridge:v1",
  "title": "DGOS opaque-origin application message bridge v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" }, { "$ref": "#/$defs/ready" }, { "$ref": "#/$defs/invoke" }, { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "instanceId": { "type": "string", "format": "uuid" },
    "hello": { "type": "object", "additionalProperties": false, "required": ["type", "instanceId", "bridgeVersion"], "properties": { "type": { "const": "dgos.host.hello" }, "instanceId": { "$ref": "#/$defs/instanceId" }, "bridgeVersion": { "const": 1 } } },
    "ready": { "type": "object", "additionalProperties": false, "required": ["type", "instanceId", "bridgeVersion"], "properties": { "type": { "const": "dgos.app.ready" }, "instanceId": { "$ref": "#/$defs/instanceId" }, "bridgeVersion": { "const": 1 } } },
    "invoke": { "type": "object", "additionalProperties": false, "required": ["type", "instanceId", "requestId", "capability", "input"], "properties": { "type": { "const": "dgos.app.invoke" }, "instanceId": { "$ref": "#/$defs/instanceId" }, "requestId": { "type": "string", "format": "uuid" }, "capability": { "type": "string" }, "input": { "type": "object" } }, "allOf": [{ "$ref": "#/$defs/call" }] },
    "call": {
      "type": "object", "required": ["capability", "input"],
      "description": "Shared capability/input validation for both HTTP AppCapabilityRequest and app.invoke. Identity and requestId come only from the authenticated envelope. Each registered handler must validate its matching branch.",
      "oneOf": [
        { "properties": { "capability": { "const": "dgos.model.list" }, "input": { "$ref": "#/$defs/modelListInput" } } },
        { "properties": { "capability": { "const": "dgos.model.resolve" }, "input": { "$ref": "#/$defs/modelResolveInput" } } },
        { "properties": { "capability": { "const": "dgos.aiTask.submit" }, "input": { "$ref": "#/$defs/taskSubmitInput" } } },
        { "properties": { "capability": { "const": "dgos.aiTask.get" }, "input": { "$ref": "#/$defs/taskInput" } } },
        { "properties": { "capability": { "const": "dgos.aiTask.events" }, "input": { "$ref": "#/$defs/taskEventsInput" } } },
        { "properties": { "capability": { "const": "dgos.aiTask.cancel" }, "input": { "$ref": "#/$defs/taskInput" } } },
        { "properties": { "capability": { "const": "dgos.artifact.read" }, "input": { "$ref": "#/$defs/artifactInput" } } },
        { "properties": { "capability": { "const": "dgos.system.context.read" }, "input": { "type": "object", "additionalProperties": false } } },
        { "properties": { "capability": { "const": "dgos.system.context.events" }, "input": { "type": "object", "additionalProperties": false, "required": ["cursor"], "properties": { "cursor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" } } } } }
      ]
    },
    "nonemptyId": { "type": "string", "minLength": 1 },
    "modelListInput": { "type": "object", "additionalProperties": false, "properties": { "providerConfigId": { "$ref": "#/$defs/nonemptyId" } } },
    "modelResolveInput": {
      "type": "object", "additionalProperties": false, "required": ["providerConfigId", "modelId", "intent"],
      "properties": { "providerConfigId": { "$ref": "#/$defs/nonemptyId" }, "modelId": { "$ref": "#/$defs/nonemptyId" }, "intent": { "const": "text.chat" } }
    },
    "taskSubmitInput": {
      "type": "object", "additionalProperties": false, "required": ["target", "intent", "input", "options"],
      "properties": {
        "target": { "$ref": "#/$defs/nonemptyId" }, "intent": { "const": "text.chat" },
        "input": { "type": "object", "additionalProperties": false, "required": ["text"], "properties": { "text": { "type": "string" } } },
        "options": { "type": "object", "additionalProperties": false, "required": ["providerConfigId", "modelId"], "properties": { "providerConfigId": { "$ref": "#/$defs/nonemptyId" }, "modelId": { "$ref": "#/$defs/nonemptyId" }, "parameters": { "$ref": "#/$defs/textParameters" } } }
      },
      "description": "V1 text bridge projection of AITaskSubmitRequest, with outer requestId injected by host. Only optional options.parameters temperature/maxOutputTokens, validated against resolved Adapter/Profile bounds server-side. Persist normalized parameters and resolved version snapshot; never forward arbitrary options."
    },
    "textParameters": { "type": "object", "additionalProperties": false, "properties": { "temperature": { "type": "number", "minimum": 0, "maximum": 2 }, "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } } },
    "taskInput": { "type": "object", "additionalProperties": false, "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/nonemptyId" } } },
    "taskEventsInput": { "type": "object", "additionalProperties": false, "required": ["taskId"], "properties": { "taskId": { "$ref": "#/$defs/nonemptyId" }, "cursor": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 } } },
    "artifactInput": { "type": "object", "additionalProperties": false, "required": ["artifactId"], "properties": { "artifactId": { "$ref": "#/$defs/nonemptyId" } } },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["type", "instanceId", "requestId"],
      "properties": { "type": { "const": "dgos.host.result" }, "instanceId": { "$ref": "#/$defs/instanceId" }, "requestId": { "type": "string", "format": "uuid" }, "result": { "type": "object", "description": "Registered capability response schema and redaction apply." }, "error": { "type": "object", "additionalProperties": false, "required": ["errorKey", "message", "requestId"], "properties": { "errorKey": { "type": "string" }, "message": { "type": "string" }, "requestId": { "type": "string" } } } },
      "oneOf": [{ "required": ["result"], "not": { "required": ["error"] } }, { "required": ["error"], "not": { "required": ["result"] } }]
    }
  }
}
