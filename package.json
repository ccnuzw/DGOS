{
  "name": "dgos-v1-foundation",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "pnpm --parallel --filter @dgos/api --filter @dgos/worker dev",
    "build": "pnpm -r build",
    "test": "node --test",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "node --check src/security/secret-service.mjs && node --check src/security/provider-egress.mjs && pnpm -r check"
  }
}
