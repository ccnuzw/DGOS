{
  "version": 3,
  "project": "DGOS",
  "team_model": "domain-based-9-roles",
  "description": "基于DGOS真实架构的领域划分团队",
  "roles": [
    {
      "name": "lead",
      "label": "Lead",
      "kind": "claude",
      "role": "lead.md",
      "description": "战略协调，快速决策（当前用户会话）"
    },
    {
      "name": "planner",
      "label": "Planner",
      "kind": "opencode",
      "role": "planner.md",
      "description": "规格驱动，使用spec-docs"
    },
    {
      "name": "worker-platform",
      "label": "Worker-Platform",
      "tabLabel": "Platform · Identity/Permission/Apps",
      "kind": "codex",
      "role": "worker-platform.md",
      "description": "Identity/Permission/Apps/System后端"
    },
    {
      "name": "worker-ai",
      "label": "Worker-AI",
      "tabLabel": "AI · Provider/Task/Extensions",
      "kind": "codex",
      "role": "worker-ai.md",
      "description": "Provider/Model/AI Task/Extensions后端"
    },
    {
      "name": "worker-web",
      "label": "Worker-Web",
      "tabLabel": "Web · React UI",
      "kind": "codex",
      "role": "worker-web.md",
      "description": "React UI全栈前端"
    },
    {
      "name": "worker-native",
      "label": "Worker-Native",
      "tabLabel": "Native · Tauri/Desktop",
      "kind": "codex",
      "role": "worker-native.md",
      "description": "Tauri/Desktop/构建打包"
    },
    {
      "name": "worker-test",
      "label": "Worker-Test",
      "tabLabel": "Test · 测试工程",
      "kind": "codex",
      "role": "worker-test.md",
      "description": "编写测试/fixture"
    },
    {
      "name": "worker-devops",
      "label": "Worker-DevOps",
      "tabLabel": "DevOps · 运维部署",
      "kind": "codex",
      "role": "worker-devops.md",
      "description": "部署/运维/CI/CD"
    },
    {
      "name": "verify",
      "label": "Verify",
      "kind": "codex",
      "role": "verify.md",
      "description": "独立验证，运行测试"
    }
  ],
  "codexArgs": [
    "--sandbox", "workspace-write",
    "--ask-for-approval", "never",
    "--disable", "computer_use"
  ],
  "opencodeArgs": ["--auto"],
  "layout": {
    "independent_tabs": ["lead", "planner", "worker-platform", "worker-ai", "worker-web", "worker-native", "verify"],
    "shared_tabs": [
      {
        "roles": ["worker-test", "worker-devops"],
        "split": "horizontal",
        "label": "Test/DevOps"
      }
    ]
  },
  "workflow": {
    "cycle": "weekly",
    "max_parallel_tasks": 6,
    "verification_sla": "4 hours",
    "blocking_limit": "1 day"
  },
  "domain_mapping": {
    "platform": ["src/identity", "src/permissions", "src/apps", "src/system", "src/audit"],
    "ai": ["src/provider", "src/provider-adapters", "src/ai-task", "src/extensions", "src/actions"],
    "web": ["apps/web", "packages/dgos-ui"],
    "native": ["apps/desktop", "apps/ai-workbench-package"],
    "test": ["tests/"],
    "devops": ["scripts/", "deployment/"]
  }
}
