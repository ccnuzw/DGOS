{
  "version": 1,
  "activeVersion": "V1",
  "policy": "docs-policy.json",
  "evidence": "docs-evidence.json",
  "authorityFiles": [
    "docs/02-产品与版本/当前版本/V1-版本总览.md",
    "docs/02-产品与版本/当前版本/V1-实现状态.md",
    "docs/04-技术架构/当前版本/V1-接口契约.md",
    "docs/04-技术架构/当前版本/V1-openapi.yaml",
    "docs/04-技术架构/当前版本/V1-数据模型.md",
    "docs/06-决策记录/V1-冻结决策.md",
    "docs/05-测试与发布/端到端验收/V1-端到端验收规范.md"
  ],
  "approvalMaxAgeDays": 30,
  "requiredReports": [
    "development",
    "e2e",
    "release"
  ],
  "requiredApprovals": [
    "product",
    "technical",
    "release_manager"
  ],
  "commandRegistry": [
    "node scripts/check-docs.mjs",
    "node scripts/docs-gate.mjs --phase release --json",
    "pnpm run check",
    "pnpm -r build",
    "pnpm run migrate:check",
    "pnpm run test:release",
    "pnpm run test:web:e2e",
    "pnpm --filter @dgos/desktop e2e:macos",
    "node --test tests/e2e/assistant-settings-actions.spec.mjs",
    "node --test tests/unit/runtime.test.mjs",
    "node --test tests/integration/ai-task-api.test.mjs",
    "node --test tests/integration/identity-api.test.mjs",
    "node --test tests/integration/provider-api.test.mjs",
    "node --test tests/integration/provider-worker.test.mjs",
    "node --test tests/security/provider-egress.test.mjs",
    "node --test tests/security/provider-egress-transport.test.mjs",
    "node --test tests/security/v1-governance-e2e.test.mjs",
    "node scripts/v1-regression-sweep.mjs --plan",
    "env -u DGOS_DATABASE_URL node --test tests/unit/runtime.test.mjs tests/integration/usage-settlement.spec.mjs"
  ],
  "requireCommitBinding": true,
  "requireManifest": true,
  "release": {
    "enforce": false,
    "allowPendingACs": false
  },
  "secretScan": {
    "enabled": true
  }
}
